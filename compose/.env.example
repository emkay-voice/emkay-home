# Emkay Home – copy to .env and change what you need.

# Time zone of the house
TZ=Europe/Copenhagen

# The ports the house is served on. 80/443 give the nicest addresses; pick
# others if something else on this machine already uses them.
HTTP_PORT=80
HTTPS_PORT=443
# The OpenVoiceOS control panel (https, behind Emkay Home's password)
PANEL_PORT=8500

# Image versions: OVOS from ovos-docker (alpha, like Emkay), Emkay Home's own
OVOS_VERSION=alpha
EMKAY_HOME_VERSION=latest

# The Emkay a paired phone opens: "house" serves Emkay from the house
# (https://<house>/emkay/), fetched from emkay-voice/emkay's release "site"
# on the first start and then once a day when there is a newer build. Or a
# URL, e.g. https://app.emkay.ai/, to always use that one.
EMKAY_URL=house

# Extra names the house may get a certificate for (comma separated), besides
# its LAN addresses and *.local / *.lan / *.home.arpa / *.internal names
EMKAY_HOME_NAMES=
